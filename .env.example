# Copiar a .env.local (ignorado por git) y rellenar con tus credenciales reales.

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase "service_role" secret (Project Settings -> API -> Project API keys).
# SOLO se usa en el servidor (api/delete-build.ts, api/update-build.ts) para
# borrar/editar validando el dueño -- nunca la mandes al cliente (sin VITE_).
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (Settings -> Upload -> Upload presets, modo "Unsigned")
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Groq (console.groq.com/keys) - solo se usa en el servidor (api/track-gods.ts),
# nunca se expone al cliente. Modelo por defecto: qwen/qwen3.8-27b
GROQ_API_KEY=
GROQ_MODEL=
